{
  "manifest_version": 3,
  "name": "Fixed Video Speed",
  "version": "1.0.0",
  "description": "Keep video playback speed fixed on YouTube and Bilibili.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.bilibili.com/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Fixed Video Speed"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.bilibili.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
