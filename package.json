{
  "name": "fixed-speed-video-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Keep video playback speed fixed across popular video websites and custom domains.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:app && npm run build:content",
    "build:app": "vite build",
    "build:content": "vite build -c vite.content.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
